# ── 数据存储（Upstash Redis / Vercel KV）────────────────────────
# 不配置时自动降级为「内存存储」：读取 data/seed.json，写入仅在当前实例生效
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 兼容 Vercel KV 的变量名
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── 后台会话签名密钥（必填，生产环境请改为随机长字符串）────────
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ── 初始超级管理员（仅首次初始化时生效）────────────────────────
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123456

# ── 图片存储（腾讯云 COS）──────────────────────────────────────
# 后台 / 小程序上传的图片都存 COS，数据库只存完整 https 地址。
# 子账号密钥只需授权 huangjin/* 前缀的 PutObject；密钥只填在这里或 Vercel 环境变量，不要提交。
# 存储桶需「公有读私有写」，图片才能在 H5 / 小程序直接显示。
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=huangjin-1259254304
TENCENT_COS_REGION=ap-guangzhou
# 可选：对外访问域名（默认 https://{bucket}.cos.{region}.myqcloud.com，接 CDN 时改这里）
TENCENT_COS_PUBLIC_URL=
# 可选：对象 key 前缀，默认 huangjin/
TENCENT_COS_PREFIX=
